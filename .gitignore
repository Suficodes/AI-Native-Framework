# DAK default .gitignore.

# Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/          # root-anchored: Python build output only — NOT frontend/src/lib
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
venv/
.venv/

# Node
node_modules/
.npm
.yarn
.pnpm-store/
dist/
dist-ssr/
*.local
.vite/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude Code worktree scratch space
.claude/worktrees/

# Logs
*.log
logs/

# Databases
*.db
*.sqlite
*.sqlite3

# Docker
.docker/
dist-artifact/

# Agent skills installed via `npx skills add` — payload is reproducible from
# skills-lock.json, so the lock file is committed and the 3MB of vendored
# docs is not. Re-install with: npx skills install
.agents/
.claude/skills/
